Print invoice table info in the required format
sql


SELECT
  CONCAT('The Invoice No. of Customer Id. ', i.cust_id,
         ' is ', i.inv_no,
         ' and Movie No. is ', i.mv_no, '.') AS A,
  CONCAT(i.cust_id,
         ' has taken Movie No. ', i.mv_no,
         ' on ', i.issue_date,
         ' and will return on ',
         i.return_date, '.') AS B
FROM Invoice i;
